@page "/"
@using SmartDesk.Application.DTOs
@inject SmartDeskApiClient Api
@inject NotificationService Notifications

<PageTitle>Dashboard — SmartDesk</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenText TextStyle="TextStyle.H4" Style="margin:0">Dashboard</RadzenText>

    @if (_loading)
    {
        <RadzenStack AlignItems="AlignItems.Center" Style="padding:3rem">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText>Loading dashboard...</RadzenText>
        </RadzenStack>
    }
    else if (_stats is not null)
    {
        <RadzenRow Gap="1rem">
            <RadzenColumn SizeXS="12" SizeSM="6" SizeMD="3">
                <StatCard Title="Open Tickets" Count="_stats.TotalOpen" Color="var(--rz-warning)" Icon="inbox" />
            </RadzenColumn>
            <RadzenColumn SizeXS="12" SizeSM="6" SizeMD="3">
                <StatCard Title="In Progress" Count="_stats.TotalInProgress" Color="var(--rz-info)" Icon="pending" />
            </RadzenColumn>
            <RadzenColumn SizeXS="12" SizeSM="6" SizeMD="3">
                <StatCard Title="Resolved" Count="_stats.TotalResolved" Color="var(--rz-success)" Icon="check_circle" />
            </RadzenColumn>
            <RadzenColumn SizeXS="12" SizeSM="6" SizeMD="3">
                <StatCard Title="Avg Resolution" Count="@((int)_stats.AvgResolutionHours)" Suffix=" hrs" Color="var(--rz-secondary)" Icon="schedule" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn SizeXS="12" SizeMD="6">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" Style="margin-bottom:1rem">Tickets by Category</RadzenText>
                    @if (_categoryData.Any())
                    {
                        <RadzenChart Style="height:250px">
                            <RadzenDonutSeries Data="_categoryData"
                                               CategoryProperty="Category"
                                               ValueProperty="Count"
                                               Title="Tickets" />
                        </RadzenChart>
                    }
                    else
                    {
                        <RadzenText Style="color:var(--rz-text-secondary-color)">No ticket data yet.</RadzenText>
                    }
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn SizeXS="12" SizeMD="6">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" Style="margin-bottom:1rem">Resolution Rate</RadzenText>
                    <RadzenArcGauge Style="height:220px">
                        <RadzenArcGaugeScale Min="0" Max="100" Value="@_resolutionRate" StartAngle="-150" EndAngle="150">
                            <RadzenArcGaugeScalePointer Value="@_resolutionRate" />
                            <RadzenArcGaugeScaleRanges>
                                <RadzenGaugeScaleRange From="0" To="50" Fill="var(--rz-danger)" />
                                <RadzenGaugeScaleRange From="50" To="75" Fill="var(--rz-warning)" />
                                <RadzenGaugeScaleRange From="75" To="100" Fill="var(--rz-success)" />
                            </RadzenArcGaugeScaleRanges>
                        </RadzenArcGaugeScale>
                    </RadzenArcGauge>
                    <RadzenText TextStyle="TextStyle.H5" Style="text-align:center">@_resolutionRate%</RadzenText>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenStack>

@code {
    private DashboardStatsDto? _stats;
    private List<CategoryCountDto> _categoryData = new();
    private bool _loading = true;
    private double _resolutionRate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stats = await Api.GetDashboardStatsAsync();
            if (_stats is not null)
            {
                _categoryData = _stats.ByCategory.ToList();
                var total = _stats.TotalOpen + _stats.TotalInProgress + _stats.TotalResolved + _stats.TotalClosed;
                _resolutionRate = total == 0 ? 0 : Math.Round((_stats.TotalResolved + _stats.TotalClosed) / (double)total * 100, 1);
            }
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Error", $"Failed to load dashboard: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
