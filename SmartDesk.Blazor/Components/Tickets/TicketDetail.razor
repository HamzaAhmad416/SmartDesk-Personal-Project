@page "/tickets/{Id:guid}"
@using SmartDesk.Application.DTOs
@using SmartDesk.Domain.Enums
@inject SmartDeskApiClient Api
@inject NotificationService Notifications
@inject NavigationManager Nav

@*
    WHY THIS PAGE IS THE MOST IMPORTANT FOR YOUR CV:
    It ties together EVERY backend feature visually:
    
    1. AI Suggested Reply — shown in a blue card if Azure Function has processed it.
       When a hirer sees "AI" badge + suggested reply, they immediately understand
       the async Service Bus → Function → OpenAI → CosmosDB pipeline.
    
    2. Agent Assignment — dropdown populated from Redis-cached agents list.
       Calling POST /assign publishes another Service Bus event.
    
    3. Internal Notes — comments with IsInternal=true show with yellow background.
       Agents use these to discuss tickets privately.
    
    4. File Attachments — links to Azure Blob SAS URLs. Direct download from Azure,
       not through the API.
    
    5. Real-time status — after any action the page refreshes the ticket from API
       (which checks Redis first, then Cosmos).
*@

<PageTitle>Ticket Detail — SmartDesk</PageTitle>

@if (_loading)
{
    <RadzenStack AlignItems="AlignItems.Center" Style="padding:3rem">
        <RadzenProgressBarCircular ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else if (_ticket is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">Ticket not found.</RadzenAlert>
}
else
{
    <RadzenStack Gap="1.5rem">

        @* ── Header ── *@
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenButton Icon="arrow_back"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Nav.NavigateTo("/tickets"))" />
            <RadzenText TextStyle="TextStyle.H5"
                        Style="flex:1; margin:0">@_ticket.Title</RadzenText>
            <RadzenBadge Text="@_ticket.Status.ToString()"
                         BadgeStyle="@StatusStyle(_ticket.Status)" />
            <RadzenBadge Text="@_ticket.Priority.ToString()"
                         BadgeStyle="@PriorityStyle(_ticket.Priority)" />
        </RadzenStack>

        <RadzenRow Gap="1.5rem">

            @* ── Left Column: Description, AI Reply, Comments ── *@
            <RadzenColumn SizeXS="12" SizeMD="8">

                @* Description *@
                <RadzenCard Style="margin-bottom:1rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1">Description</RadzenText>
                    <RadzenText Style="white-space:pre-wrap">@_ticket.Description</RadzenText>
                </RadzenCard>

                @* AI Suggested Reply — only visible once Azure Function processes the ticket *@
                @if (!string.IsNullOrEmpty(_ticket.AiSuggestedReply))
                {
                    <RadzenCard Style="margin-bottom:1rem; border-left:4px solid var(--rz-info)">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     Gap="0.5rem"
                                     Style="margin-bottom:0.5rem">
                            <RadzenIcon Icon="smart_toy"
                                        Style="color:var(--rz-info)" />
                            <RadzenText TextStyle="TextStyle.Subtitle1"
                                        Style="color:var(--rz-info); margin:0">
                                AI Suggested Reply
                            </RadzenText>
                            <RadzenBadge Text="Generated by OpenAI"
                                         BadgeStyle="BadgeStyle.Info" />
                        </RadzenStack>
                        <RadzenText Style="white-space:pre-wrap">
                            @_ticket.AiSuggestedReply
                        </RadzenText>
                        <RadzenButton Text="Use this reply"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Style="margin-top:0.75rem"
                                      Click="@(() => _newComment = _ticket.AiSuggestedReply ?? string.Empty)" />
                    </RadzenCard>
                }

                @* Comments *@
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.Subtitle1"
                                Style="margin-bottom:1rem">
                        Comments (@_ticket.Comments.Count())
                    </RadzenText>

                    @foreach (var c in _ticket.Comments.OrderBy(x => x.CreatedAt))
                    {
                        <RadzenCard Style="@($"margin-bottom:0.75rem; {(c.IsInternal ? "background:var(--rz-warning-lighter, #fff8e1)" : "")}")">
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         JustifyContent="JustifyContent.SpaceBetween"
                                         Style="margin-bottom:0.4rem">
                                <RadzenStack Orientation="Orientation.Horizontal"
                                             AlignItems="AlignItems.Center" Gap="0.5rem">
                                    @if (c.IsAiGenerated)
                                    {
                                        <RadzenIcon Icon="smart_toy"
                                                    Style="color:var(--rz-info)" />
                                    }
                                    <RadzenText TextStyle="TextStyle.Subtitle2"
                                                Style="margin:0">@c.Author</RadzenText>
                                    @if (c.IsInternal)
                                    {
                                        <RadzenBadge Text="Internal"
                                                     BadgeStyle="BadgeStyle.Warning" />
                                    }
                                </RadzenStack>
                                <RadzenText TextStyle="TextStyle.Caption">
                                    @c.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                </RadzenText>
                            </RadzenStack>
                            <RadzenText Style="white-space:pre-wrap">@c.Body</RadzenText>
                        </RadzenCard>
                    }

                    @* Add comment form *@
                    <RadzenStack Gap="0.75rem" Style="margin-top:1rem">
                        <RadzenTextArea @bind-value="_newComment"
                                        Rows="3"
                                        Placeholder="Write a comment..."
                                        Style="width:100%" />
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenCheckBox @bind-value="_isInternal"
                                                Name="isInternal" />
                                <RadzenLabel Text="Internal note (agents only)"
                                             Component="isInternal" />
                            </RadzenStack>
                            <RadzenButton Text="Post Comment"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Size="ButtonSize.Small"
                                          Disabled="@string.IsNullOrWhiteSpace(_newComment)"
                                          Click="PostCommentAsync" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            @* ── Right Column: Details, Actions, Attachments ── *@
            <RadzenColumn SizeXS="12" SizeMD="4">

                @* Ticket details *@
                <RadzenCard Style="margin-bottom:1rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1"
                                Style="margin-bottom:1rem">Details</RadzenText>
                    <RadzenStack Gap="0.5rem">
                        <DetailRow Label="Category" Value="@_ticket.Category.ToString()" />
                        <DetailRow Label="Submitted By" Value="@_ticket.SubmittedBy" />
                        <DetailRow Label="Assigned To"
                                   Value="@(_ticket.AssignedAgent ?? "Unassigned")" />
                        <DetailRow Label="Created"
                                   Value="@_ticket.CreatedAt.ToString("dd MMM yyyy")" />
                        @if (_ticket.ResolvedAt.HasValue)
                        {
                            <DetailRow Label="Resolved"
                                       Value="@_ticket.ResolvedAt.Value.ToString("dd MMM yyyy")" />
                        }
                    </RadzenStack>
                </RadzenCard>

                @* Agent actions *@
                <RadzenCard Style="margin-bottom:1rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1"
                                Style="margin-bottom:1rem">Actions</RadzenText>
                    <RadzenStack Gap="0.75rem">
                        <RadzenDropDown @bind-value="_selectedAgentId"
                                        Data="_agents"
                                        TextProperty="DisplayName"
                                        ValueProperty="Id"
                                        Placeholder="Select agent..."
                                        Style="width:100%" />
                        <RadzenButton Text="Assign Ticket"
                                      ButtonStyle="ButtonStyle.Info"
                                      Style="width:100%"
                                      Disabled="@(_selectedAgentId == Guid.Empty)"
                                      Click="AssignAsync" />
                        <RadzenButton Text="Mark as Resolved"
                                      ButtonStyle="ButtonStyle.Success"
                                      Style="width:100%"
                                      Disabled="@(_ticket.Status == TicketStatus.Resolved || _ticket.Status == TicketStatus.Closed)"
                                      Click="ResolveAsync" />
                    </RadzenStack>
                </RadzenCard>

                @* Attachments *@
                @if (_ticket.Attachments.Any())
                {
                    <RadzenCard>
                        <RadzenText TextStyle="TextStyle.Subtitle1"
                                    Style="margin-bottom:1rem">
                            Attachments
                        </RadzenText>
                        @foreach (var att in _ticket.Attachments)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         Gap="0.5rem"
                                         Style="margin-bottom:0.5rem">
                                <RadzenIcon Icon="attach_file" />
                                <a href="@att.BlobUrl" target="_blank">
                                    @att.FileName
                                </a>
                                <RadzenText TextStyle="TextStyle.Caption"
                                            Style="margin-left:auto">
                                    @(att.FileSizeBytes / 1024)KB
                                </RadzenText>
                            </RadzenStack>
                        }
                    </RadzenCard>
                }
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private TicketDetailDto? _ticket;
    private List<UserDto> _agents = new();
    private bool _loading = true;
    private Guid _selectedAgentId;
    private string _newComment = string.Empty;
    private bool _isInternal;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var ticketTask = Api.GetTicketAsync(Id);
            var agentsTask = Api.GetAgentsAsync();
            await Task.WhenAll(ticketTask, agentsTask);
            _ticket = ticketTask.Result;
            _agents = agentsTask.Result;
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally { _loading = false; }
    }

    private async Task AssignAsync()
    {
        try
        {
            await Api.AssignTicketAsync(Id, _selectedAgentId);
            _ticket = await Api.GetTicketAsync(Id);
            Notifications.Notify(NotificationSeverity.Success,
                "Assigned", "Ticket assigned successfully.");
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
    }

    private async Task ResolveAsync()
    {
        try
        {
            await Api.ResolveTicketAsync(Id);
            _ticket = await Api.GetTicketAsync(Id);
            Notifications.Notify(NotificationSeverity.Success,
                "Resolved", "Ticket marked as resolved.");
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
    }

    private async Task PostCommentAsync()
    {
        try
        {
            await Api.AddCommentAsync(Id,
                new CreateCommentRequest(_newComment, _isInternal));
            _newComment = string.Empty;
            _isInternal = false;
            _ticket = await Api.GetTicketAsync(Id);
            Notifications.Notify(NotificationSeverity.Success,
                "Comment added.");
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
    }

    private BadgeStyle StatusStyle(TicketStatus s) => s switch
    {
        TicketStatus.Open       => BadgeStyle.Warning,
        TicketStatus.InProgress => BadgeStyle.Info,
        TicketStatus.Resolved   => BadgeStyle.Success,
        TicketStatus.Closed     => BadgeStyle.Light,
        _                       => BadgeStyle.Secondary
    };

    private BadgeStyle PriorityStyle(TicketPriority p) => p switch
    {
        TicketPriority.Critical => BadgeStyle.Danger,
        TicketPriority.High     => BadgeStyle.Warning,
        TicketPriority.Medium   => BadgeStyle.Info,
        _                       => BadgeStyle.Light
    };
}
